--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -1182,6 +1182,26 @@ static int override_release(char __user *release, size_t len)
 	return ret;
 }
 
+#ifdef CONFIG_KSU
+/*
+ * ColorOS 15 (Android 15 / API 35) ships a tethering APEX whose netbpfload
+ * refuses to run when uname()->release reports a kernel below 4.19
+ * ("Android V requires kernel 4.19.") and init then performs
+ * 'reboot,bpfloader-failed' via reboot_on_failure, producing a boot loop.
+ * The physical kernel is 4.14, so report a >= 4.19 release to that single
+ * process only (keyed on ->comm, the same way KernelPatch does it). All
+ * other processes keep real 4.14 semantics; a global override breaks the
+ * kernel BPF subsystem.
+ */
+static bool ksu_is_bpfloader_task(void)
+{
+	return (current->comm[10] == '\0' &&
+		!strncmp(current->comm, "netbpfload", 10)) ||
+	       (current->comm[9] == '\0' &&
+		!strncmp(current->comm, "bpfloader", 9));
+}
+#endif
+
 SYSCALL_DEFINE1(newuname, struct new_utsname __user *, name)
 {
 	struct new_utsname tmp;
@@ -1189,6 +1209,10 @@ SYSCALL_DEFINE1(newuname, struct new_utsname __user *, name)
 	down_read(&uts_sem);
 	memcpy(&tmp, utsname(), sizeof(tmp));
 	up_read(&uts_sem);
+#ifdef CONFIG_KSU
+	if (ksu_is_bpfloader_task())
+		memcpy(tmp.release, "4.19.280-perf", sizeof("4.19.280-perf"));
+#endif
 	if (copy_to_user(name, &tmp, sizeof(tmp)))
 		return -EFAULT;
 
